# Copy this file to .env and adjust as needed. Every value has a sensible
# default; a plain LAN install works without changing anything.

# Address and port on the host where LinkSave listens.
# LinkSave has NO login of its own. Bind it to a LAN or VPN address you trust
# (0.0.0.0 = every interface on this host), or to 127.0.0.1 when a reverse
# proxy or tunnel on the same host is the only way in.
LINKSAVE_BIND=0.0.0.0
LINKSAVE_PORT=3017

# Public URL used in messages and generated links.
PUBLIC_BASE_URL=http://localhost:3017

# Redis connection shared by the app/API container and worker container.
REDIS_URL=redis://redis:6379

# Temporary media storage inside containers (a dedicated writable volume; the
# rest of the container filesystem is read-only).
TEMP_DIR=/data/media

# Job and cleanup limits.
MAX_GLOBAL_CONCURRENT_JOBS=2
# Without Cloudflare Access, "user" means client IP address.
MAX_CONCURRENT_JOBS_PER_USER=1
MAX_VIDEO_DURATION_SECONDS=7200
MAX_FILE_SIZE_BYTES=2147483648
JOB_EXPIRATION_SECONDS=900
CLEANUP_INTERVAL_SECONDS=60
INSPECT_TIMEOUT_MS=25000
# Hard wall-clock limit for a single download before yt-dlp is killed.
DOWNLOAD_TIMEOUT_MS=1200000

# Offer 4K in the app (hidden behind the settings menu). Set to false to remove
# the 4K option entirely; "Best" then always caps at 1080p, even if a client
# tries to request more.
ALLOW_4K=true

# Keep yt-dlp current automatically. The worker updates it on startup and once a
# day into a writable volume, falling back to the version baked into the image
# if an update ever fails. Set to false to pin the built-in version.
YT_DLP_AUTO_UPDATE=true
# Where the auto-updated yt-dlp is stored (a dedicated writable volume).
YT_DLP_DIR=/data/yt-dlp

# Rate limits per user and IP. Keep this above ~40: the page polls download
# status every 2 seconds while a download is running.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# ---------------------------------------------------------------------------
# Optional: Cloudflare Access + Cloudflare Tunnel.
# Only needed if you publish LinkSave on the internet through Cloudflare and
# want the app to verify the Cloudflare Access login. Any other protection
# (VPN, Tailscale, an authenticating reverse proxy) works without these.
# ---------------------------------------------------------------------------

# When true, every /api and /download request must carry a valid Cloudflare
# Access JWT, and the two CF_ACCESS_* values below are required.
REQUIRE_CLOUDFLARE_ACCESS=false
# Team domain: "myteam" or "myteam.cloudflareaccess.com" (the JWT issuer).
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag from the Access application's settings.
CF_ACCESS_AUD=

# Cloudflare Tunnel token, used by the optional `cloudflared` service:
#   docker compose --profile cloudflare up -d
CLOUDFLARED_TOKEN=
